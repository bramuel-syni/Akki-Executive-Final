# AKKI frontend image — CRA + CRACO build, served by nginx.
#
# REACT_APP_BACKEND_URL is baked into the JS bundle at build time
# (CRA inlines `process.env.REACT_APP_*`). Changing the URL therefore
# requires a full image rebuild, not just a container restart. The
# CI workflow passes it as a --build-arg.
#
# Stage 1 (builder)  — node 20 alpine, yarn install (lockfile present),
#                       craco build, output to /app/frontend/build.
# Stage 2 (runtime)  — nginx 1.27 alpine, copy build artefact, mount
#                       Cloudflare origin cert + key at runtime via
#                       compose volumes (NOT baked into the image).

# ---------------------------------------------------------------------------
# Stage 1 — builder
# ---------------------------------------------------------------------------
FROM node:20-alpine AS builder

# Build-arg → env-var so CRA picks it up via process.env.
ARG REACT_APP_BACKEND_URL
ENV REACT_APP_BACKEND_URL=${REACT_APP_BACKEND_URL}
ENV CI=true \
    NODE_ENV=production

# Native build deps that some transitive packages (e.g. node-gyp) need.
RUN apk add --no-cache python3 make g++

WORKDIR /app/frontend

# Lockfile-faithful install. yarn.lock is the source of truth (per
# package.json packageManager pin) — DO NOT silently switch to npm.
COPY frontend/package.json frontend/yarn.lock ./
RUN yarn install --frozen-lockfile --network-timeout 600000

COPY frontend/ ./
RUN yarn build

# ---------------------------------------------------------------------------
# Stage 2 — runtime (nginx)
# ---------------------------------------------------------------------------
FROM nginx:1.27-alpine AS runtime

# curl for HEALTHCHECK; tzdata for log timestamps.
RUN apk add --no-cache curl tzdata \
 && ln -snf /usr/share/zoneinfo/Etc/UTC /etc/localtime

# Custom config — replaces the default site entirely.
RUN rm -f /etc/nginx/conf.d/default.conf
COPY nginx/frontend.conf /etc/nginx/conf.d/akki.conf

COPY --from=builder /app/frontend/build /usr/share/nginx/html

# Origin cert + key are NOT baked in — they arrive via volume mount
# from /etc/akki/origin.{crt,key} on the VM (see docker-compose.prod.yml).

EXPOSE 80 443

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD curl -fsS http://localhost/healthz || exit 1

STOPSIGNAL SIGQUIT
CMD ["nginx", "-g", "daemon off;"]
